#N canvas 0 0 620 420 12;
#X obj 30 20 table ge-sample-\$1 64;
#X obj 330 20 catch~ ge-sample-\$1-pos;
#X obj 330 50 s~ ge-sample-\$1-at;
#X obj 30 70 loadbang;
#X obj 30 100 samplerate~;
#X obj 30 130 t f f;
#X obj 180 160 s ge-sample-\$1-rate;
#X obj 30 160 * \$2;
#X obj 30 190 / 64;
#X obj 30 220 + 0.5;
#X obj 30 250 i;
#X obj 30 280 max 1;
#X obj 30 310 * 64;
#X obj 30 340 t f f;
#X msg 180 340 resize \$1;
#X obj 180 370 s ge-sample-\$1;
#X obj 30 380 s ge-sample-\$1-size;
#X text 30 400 Arguments: slot - seconds. Sends the rate in Hz and then the size in samples.;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 1 6 0;
#X connect 5 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 14 0 15 0;
#X connect 13 1 14 0;
#X connect 13 0 16 0;

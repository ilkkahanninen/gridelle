#N canvas 0 0 620 320 12;
#X obj 30 20 table ge-sample-\$1 64;
#X obj 330 20 catch~ ge-sample-\$1-pos;
#X obj 330 50 s~ ge-sample-\$1-at;
#X obj 30 70 loadbang;
#X obj 30 100 list append \$2 ge-sample-\$1;
#X msg 30 130 read -resize \$1 \$2;
#X obj 30 160 soundfiler;
#X obj 30 220 s ge-sample-\$1-size;
#X obj 180 190 list split 1;
#X obj 180 220 s ge-sample-\$1-rate;
#X text 30 270 Arguments: slot - file name. Sends the sample's rate in Hz and then its size in samples.;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 6 1 8 0;
#X connect 8 0 9 0;

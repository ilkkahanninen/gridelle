#N canvas 0 0 420 260 12;
#X obj 30 20 inlet~;
#X obj 160 20 r \$1-level;
#X obj 160 50 pack f 20;
#X obj 160 80 line~;
#X obj 30 120 *~;
#X obj 30 170 outlet~;
#X text 30 210 Inlet: a signal. Outlet: the signal times Level \, which a 20 ms ramp smooths.;
#X connect 0 0 4 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 1;
#X connect 4 0 5 0;

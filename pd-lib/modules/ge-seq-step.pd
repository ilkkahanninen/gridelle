#N canvas 0 0 520 360 12;
#X obj 30 20 inlet~;
#X obj 150 20 inlet~;
#X obj 270 20 inlet~;
#X obj 30 70 -~ \$1;
#X obj 30 100 abs~;
#X obj 30 130 *~ -1;
#X obj 30 160 +~ 1;
#X obj 30 190 max~ 0;

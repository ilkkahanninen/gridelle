#N canvas 0 0 640 420 12;
#X obj 30 20 r notes;
#X obj 30 50 unpack f f;
#X obj 30 80 poly 4 1;
#X obj 30 110 - 1;
#X obj 30 140 pack f f f;
#X obj 30 180 clone voice 4;
#X obj 30 220 *~ 0.25;
#X obj 30 260 throw~ outL;
#X obj 130 260 throw~ outR;
#X obj 300 80 r knob1;
#X obj 300 110 expr 100 + \$f1 * \$f1 * 6000;
#X obj 300 180 s spike-cutoff;
#X msg 430 140 Cutoff \$1 Hz;
#X obj 430 180 s screenLine1;
#X obj 300 20 loadbang;
#X msg 300 50 0.5;
#X obj 300 240 r aux;
#X obj 300 270 * 3;
#X obj 300 300 s led;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 1 2 1;
#X connect 2 0 3 0;

#N canvas 0 0 420 320 12;
#X obj 30 20 inlet~;
#X obj 200 20 inlet~;
#X obj 300 60 block~ 1;
#X obj 200 80 delread~ \$0-peak 0;
#X obj 200 120 *~;
#X obj 30 170 max~;
#X obj 200 210 delwrite~ \$0-peak 10;
#X obj 30 260 outlet~;
#X text 30 290 Inlets: a level (not below 0) - what is kept of the peak from one sample to the next. Out: the level or the peak so far times that - whichever is higher. A block is one sample here - so that the delay is one too.;
#X connect 3 0 4 0;
#X connect 1 0 4 1;
#X connect 0 0 5 0;
#X connect 4 0 5 1;
#X connect 5 0 6 0;
#X connect 5 0 7 0;

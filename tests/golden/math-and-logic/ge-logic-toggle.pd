#N canvas 0 0 460 420 12;
#X obj 30 20 inlet~;
#X obj 30 60 -~ 0.5;
#X obj 30 90 *~ 1000000;
#X obj 30 120 clip~ 0 1;
#X obj 30 160 rzero~ 1;
#X obj 30 190 max~ 0;
#X obj 30 220 rpole~ 1;
#X obj 30 260 *~ 0.5;
#X obj 30 290 wrap~;
#X obj 30 320 *~ 2;
#X obj 30 370 outlet~;
#X text 120 370 Out: 1 after the first \, third \, fifth ... time the input goes on \, 0 after the others.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;

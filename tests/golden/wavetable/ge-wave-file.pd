#N canvas 0 0 620 260 12;
#X obj 30 20 table ge-wave-\$1 64;
#X obj 30 70 loadbang;
#X obj 30 100 list append \$2 ge-wave-\$1;
#X msg 30 130 read -resize \$1 \$2;
#X obj 30 160 soundfiler;
#X obj 30 200 s ge-wave-\$1-size;
#X text 30 230 Arguments: slot - file name. Reads a wavetable and sends its size in points: a record of 16414 for each frame.;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
